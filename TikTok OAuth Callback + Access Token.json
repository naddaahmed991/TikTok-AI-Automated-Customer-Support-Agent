    {
      "parameters": {
        "jsCode": "const raw = $json.output ?? '';\nlet parsed;\ntry {\n  parsed = typeof raw === 'object' ? raw : JSON.parse(raw);\n} catch (e) {\n  parsed = {\n    reply: String(raw),\n    human_review: false,\n    reason: ''\n  };\n}\nreturn [{\n  json: {\n    ...$json,\n    reply: parsed.reply || '',\n    human_review: Boolean(parsed.human_review),\n    review_reason: parsed.reason || ''\n  }\n}];"
      },
